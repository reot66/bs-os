{
  "name": "@business-os/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json && bunx --bun tsc --noEmit -p tsconfig.tools.json",
    "build": "bun build ./src/index.ts --target node --format esm --packages external --outdir ./dist && bunx --bun tsc --emitDeclarationOnly -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:status": "bun run ./tools/migrations/status-local.ts",
    "db:apply": "bun run ./tools/migrations/apply-local.ts",
    "db:provision:migrator": "bun run ./tools/migrations/provision-local-role.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@business-os/configuration": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}

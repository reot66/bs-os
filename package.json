{
  "name": "business-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0 <2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '@business-os/*' typecheck",
    "build": "bun run --filter '@business-os/*' build",
    "test": "bun run build && bun test",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@business-os/configuration": "workspace:*",
    "@business-os/contracts": "workspace:*",
    "typescript": "5.9.3"
  }
}

# Business OS - local environment template
#
# Copy to .env and replace every REPLACE_WITH_* placeholder with a strong
# local-only value. Never commit your real .env file.
#
# This file is documentation, not a production configuration.
# The authoritative list of supported variables, their validation rules,
# and their sensitivity classification lives in @business-os/configuration.
# A template drift test fails the build if this file and that registry
# disagree, so add new variables in both places.

# ---------------------------------------------------------------------------
# Runtime bootstrap
# ---------------------------------------------------------------------------

# Required. One of: local, test, staging, production. Case-sensitive.
BUSINESS_OS_ENV=local

# Optional. One of: debug, info, warn, error. Defaults to info when absent.
BUSINESS_OS_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Application database access (least-privilege runtime role)
# ---------------------------------------------------------------------------

BUSINESS_OS_DB_HOST=127.0.0.1

# Integer string between 1 and 65535.
# 55432 avoids colliding with a standard local PostgreSQL install.
BUSINESS_OS_DB_PORT=55432

BUSINESS_OS_DB_NAME=business_os_local

# Explicit TLS decision: exactly "true" or "false".
# "false" is acceptable only for loopback-bound local development.
# A production runtime requires "true".
BUSINESS_OS_DB_SSL=false

BUSINESS_OS_DB_APP_USER=business_os_app
BUSINESS_OS_DB_APP_PASSWORD=REPLACE_WITH_STRONG_LOCAL_APP_PASSWORD

# ---------------------------------------------------------------------------
# Local database administration (bootstrap superuser, local use only)
# ---------------------------------------------------------------------------
# Never use this account for application runtime connections.

BUSINESS_OS_DB_USER=business_os_local
BUSINESS_OS_DB_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD

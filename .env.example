# Business OS - local PostgreSQL development
# Copy to .env and replace the password with a strong local-only value.
# Never commit your real .env file.

BUSINESS_OS_DB_NAME=business_os_local
BUSINESS_OS_DB_USER=business_os_local
BUSINESS_OS_DB_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
BUSINESS_OS_DB_PORT=55432

# Local application database account (not the bootstrap admin)
BUSINESS_OS_DB_APP_USER=business_os_app
BUSINESS_OS_DB_APP_PASSWORD=REPLACE_WITH_STRONG_LOCAL_APP_PASSWORD
